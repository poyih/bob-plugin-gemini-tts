{
  "identifier": "bob-plugin-gemini-tts",
  "version": "1.4.0",
  "category": "tts",
  "name": "Gemini TTS",
  "summary": "使用 Google Gemini TTS API 进行语音合成。",
  "icon": "",
  "author": "poyih & Claude",
  "homepage": "https://github.com/poyih/bob-plugin-gemini-tts",
  "appcast": "https://github.com/poyih/bob-plugin-gemini-tts/raw/main/appcast.json",
  "minBobVersion": "1.20.0",
  "options": [
    {
      "identifier": "apiKey",
      "type": "text",
      "title": "API Key",
      "defaultValue": "",
      "textConfig": {
        "type": "secure",
        "placeholderText": "请输入 Gemini API Key"
      }
    },
    {
      "identifier": "apiUrl",
      "type": "text",
      "title": "自定义 API 地址",
      "defaultValue": "https://generativelanguage.googleapis.com",
      "desc": "仅限 HTTPS（本机地址可用 HTTP）；第三方代理会收到 API Key 和正文",
      "textConfig": {
        "type": "visible",
        "placeholderText": "https://generativelanguage.googleapis.com"
      }
    },
    {
      "identifier": "model",
      "type": "menu",
      "title": "模型",
      "defaultValue": "gemini-3.8-flash-tts",
      "desc": "3.8 系列为正式版，逐字朗读正文；泰语、瑞典语、芬兰语、斯瓦希里语等部分语言仅 Flash 支持。3.1 / 2.5 预览模型最早于 2026-11-17 关闭，选中时会自动改用 gemini-3.8-flash-tts",
      "menuValues": [
        { "title": "Gemini 3.8 Flash TTS", "value": "gemini-3.8-flash-tts" },
        { "title": "Gemini 3.8 Flash-Lite TTS", "value": "gemini-3.8-flash-lite-tts" },
        { "title": "Gemini 3.1 Flash TTS（最早11月17日停用，改用 3.8）", "value": "gemini-3.1-flash-tts-preview" },
        { "title": "Gemini 2.5 Pro TTS（最早11月17日停用，改用 3.8）", "value": "gemini-2.5-pro-preview-tts" },
        { "title": "Gemini 2.5 Flash TTS（最早11月17日停用，改用 3.8）", "value": "gemini-2.5-flash-preview-tts" }
      ]
    },
    {
      "identifier": "requestFormat",
      "type": "menu",
      "title": "请求格式",
      "defaultValue": "auto",
      "desc": "默认按已知模型选择；未知模型或代理别名请明确指定其接口格式",
      "menuValues": [
        { "title": "自动（已知模型）", "value": "auto" },
        { "title": "3.8 格式（正文逐字朗读）", "value": "verbatim" },
        { "title": "旧版格式（提示词控制）", "value": "legacy" }
      ]
    },
    {
      "identifier": "voice",
      "type": "menu",
      "title": "声音",
      "defaultValue": "Kore",
      "desc": "填写了「自定义声音 ID」时以自定义 ID 为准",
      "menuValues": [
        { "title": "Zephyr - Bright (明亮)", "value": "Zephyr" },
        { "title": "Puck - Upbeat (欢快)", "value": "Puck" },
        { "title": "Charon - Informative (信息型)", "value": "Charon" },
        { "title": "Kore - Firm (沉稳)", "value": "Kore" },
        { "title": "Fenrir - Excitable (活泼)", "value": "Fenrir" },
        { "title": "Leda - Youthful (年轻)", "value": "Leda" },
        { "title": "Orus - Firm (沉稳)", "value": "Orus" },
        { "title": "Aoede - Breezy (轻快)", "value": "Aoede" },
        { "title": "Callirrhoe - Easy-going (随和)", "value": "Callirrhoe" },
        { "title": "Autonoe - Bright (明亮)", "value": "Autonoe" },
        { "title": "Enceladus - Breathy (气声)", "value": "Enceladus" },
        { "title": "Iapetus - Clear (清晰)", "value": "Iapetus" },
        { "title": "Umbriel - Easy-going (随和)", "value": "Umbriel" },
        { "title": "Algieba - Smooth (柔滑)", "value": "Algieba" },
        { "title": "Despina - Smooth (柔滑)", "value": "Despina" },
        { "title": "Erinome - Clear (清晰)", "value": "Erinome" },
        { "title": "Algenib - Gravelly (沙哑)", "value": "Algenib" },
        { "title": "Rasalgethi - Informative (信息型)", "value": "Rasalgethi" },
        { "title": "Laomedeia - Upbeat (欢快)", "value": "Laomedeia" },
        { "title": "Achernar - Soft (柔和)", "value": "Achernar" },
        { "title": "Alnilam - Firm (沉稳)", "value": "Alnilam" },
        { "title": "Schedar - Even (平稳)", "value": "Schedar" },
        { "title": "Gacrux - Mature (成熟)", "value": "Gacrux" },
        { "title": "Pulcherrima - Forward (直率)", "value": "Pulcherrima" },
        { "title": "Achird - Friendly (友好)", "value": "Achird" },
        { "title": "Zubenelgenubi - Casual (休闲)", "value": "Zubenelgenubi" },
        { "title": "Vindemiatrix - Gentle (温柔)", "value": "Vindemiatrix" },
        { "title": "Sadachbia - Lively (生动)", "value": "Sadachbia" },
        { "title": "Sadaltager - Knowledgeable (博学)", "value": "Sadaltager" },
        { "title": "Sulafat - Warm (温暖)", "value": "Sulafat" }
      ]
    },
    {
      "identifier": "customVoice",
      "type": "text",
      "title": "自定义声音 ID",
      "defaultValue": "",
      "desc": "可选，填写后覆盖上方的声音选择。支持声音库中的声音 ID，以及声音设计或声音复刻得到的 voice_... 或 voicekey_...；仅限 3.8 格式",
      "textConfig": {
        "type": "visible",
        "placeholderText": "如：voice_abc123"
      }
    },
    {
      "identifier": "instructions",
      "type": "text",
      "title": "语音指令",
      "defaultValue": "",
      "desc": "可选，用于控制语音风格和语气，不会被朗读出来",
      "textConfig": {
        "type": "visible",
        "height": 80,
        "placeholderText": "如：用欢快的语气朗读、Say cheerfully"
      }
    }
  ]
}
